const canvas = document.getElementById("renderCanvas");
const engine = new BABYLON.Engine(canvas, true);

const createScene = function () {
    const scene = new BABYLON.Scene(engine);
    scene.clearColor = new BABYLON.Color4(0.5, 0.75, 0.95, 1);

    const camera = new BABYLON.FollowCamera(
        "camera",
        new BABYLON.Vector3(0, 5, -10),
        scene
    );
    camera.radius = 12;
    camera.heightOffset = 5;
    camera.cameraAcceleration = 0.08;
    camera.maxCameraSpeed = 20;

    const light = new BABYLON.HemisphericLight(
        "light",
        new BABYLON.Vector3(0, 1, 0),
        scene
    );

    const ground = BABYLON.MeshBuilder.CreateGround(
        "ground",
        { width: 300, height: 300 },
        scene
    );

    const grass = new BABYLON.StandardMaterial("grass", scene);
    grass.diffuseColor = new BABYLON.Color3(0.25, 0.55, 0.25);
    ground.material = grass;

    // सड़कें
    const roadMat = new BABYLON.StandardMaterial("road", scene);
    roadMat.diffuseColor = new BABYLON.Color3(0.16, 0.16, 0.18);

    for (let i = -100; i <= 100; i += 40) {
        const road = BABYLON.MeshBuilder.CreateBox(
            "road",
            { width: 12, height: 0.1, depth: 300 },
            scene
        );
        road.position.x = i;
        road.position.y = 0.06;
        road.material = roadMat;

        const crossRoad = BABYLON.MeshBuilder.CreateBox(
            "crossRoad",
            { width: 300, height: 0.1, depth: 12 },
            scene
        );
        crossRoad.position.z = i;
        crossRoad.position.y = 0.07;
        crossRoad.material = roadMat;
    }

    // शहर की बिल्डिंग
    for (let x = -100; x <= 100; x += 20) {
        for (let z = -100; z <= 100; z += 20) {
            if (Math.abs(x % 40) < 12 || Math.abs(z % 40) < 12) {
                continue;
            }

            const h = 8 + Math.random() * 25;
            const building = BABYLON.MeshBuilder.CreateBox(
                "building",
                { width: 10, height: h, depth: 10 },
                scene
            );

            building.position.set(x, h / 2, z);

            const mat = new BABYLON.StandardMaterial(
                "buildingMat" + x + "_" + z,
                scene
            );
            mat.diffuseColor = new BABYLON.Color3(
                0.35 + Math.random() * 0.4,
                0.4 + Math.random() * 0.4,
                0.5 + Math.random() * 0.4
            );
            building.material = mat;
        }
    }

    // खिलाड़ी
    const player = new BABYLON.TransformNode("player", scene);
    player.position.set(0, 0, 0);

    const bodyMat = new BABYLON.StandardMaterial("bodyMat", scene);
    bodyMat.diffuseColor = new BABYLON.Color3(0.1, 0.3, 0.9);

    const body = BABYLON.MeshBuilder.CreateBox(
        "body",
        { width: 1, height: 1.8, depth: 0.5 },
        scene
    );
    body.position.y = 1;
    body.material = bodyMat;
    body.parent = player;

    const head = BABYLON.MeshBuilder.CreateSphere(
        "head",
        { diameter: 0.65 },
        scene
    );
    head.position.y = 2.25;
    head.parent = player;

    camera.lockedTarget = player;

    // कार
    const car = new BABYLON.TransformNode("car", scene);
    car.position.set(4, 0, 0);

    const carMat = new BABYLON.StandardMaterial("carMat", scene);
    carMat.diffuseColor = new BABYLON.Color3(0.9, 0.05, 0.03);

    const carBody = BABYLON.MeshBuilder.CreateBox(
        "carBody",
        { width: 2.2, height: 0.8, depth: 4 },
        scene
    );
    carBody.position.y = 0.8;
    carBody.material = carMat;
    carBody.parent = car;

    const cabin = BABYLON.MeshBuilder.CreateBox(
        "cabin",
        { width: 1.6, height: 0.7, depth: 1.8 },
        scene
    );
    cabin.position.set(0, 1.5, -0.2);
    cabin.parent = car;

    for (const x of [-1, 1]) {
        for (const z of [-1.3, 1.3]) {
            const wheel = BABYLON.MeshBuilder.CreateCylinder(
                "wheel",
                { diameter: 0.7, height: 0.3 },
                scene
            );
            wheel.rotation.z = Math.PI / 2;
            wheel.position.set(x, 0.45, z);
            wheel.parent = car;
        }
    }

    // कीबोर्ड और मोबाइल कंट्रोल
    const keys = {};
    window.addEventListener("keydown", e => keys[e.key.toLowerCase()] = true);
    window.addEventListener("keyup", e => keys[e.key.toLowerCase()] = false);

    let driving = false;
    let speed = 0;

    const advancedTexture =
        BABYLON.GUI.AdvancedDynamicTexture.CreateFullscreenUI("UI");

    function addButton(text, left, top, callback) {
        const button = BABYLON.GUI.Button.CreateSimpleButton(text, text);
        button.width = "100px";
        button.height = "55px";
        button.color = "white";
        button.background = "#222222dd";
        button.cornerRadius = 12;
        button.horizontalAlignment =
            BABYLON.GUI.Control.HORIZONTAL_ALIGNMENT_LEFT;
        button.verticalAlignment =
            BABYLON.GUI.Control.VERTICAL_ALIGNMENT_TOP;
        button.left = left;
        button.top = top;
        button.onPointerDownObservable.add(callback);
        advancedTexture.addControl(button);
        return button;
    }

    addButton("▲", "20px", "70%", () => {
        if (driving) speed = Math.min(speed + 0.15, 1.2);
        else player.position.z += 1;
    });

    addButton("▼", "20px", "82%", () => {
        if (driving) speed = Math.max(speed - 0.15, -0.6);
        else player.position.z -= 1;
    });

    addButton("◀", "130px", "82%", () => {
        if (driving) car.rotation.y -= 0.15;
        else player.position.x -= 1;
    });

    addButton("▶", "240px", "82%", () => {
        if (driving) car.rotation.y += 0.15;
        else player.position.x += 1;
    });

    addButton("ENTER / EXIT", "20px", "10px", () => {
        if (!driving &&
            BABYLON.Vector3.Distance(player.position, car.position) < 8) {
            driving = true;
            player.setEnabled(false);
            camera.lockedTarget = car;
        } else if (driving) {
            driving = false;
            player.setEnabled(true);
            player.position.copyFrom(car.position);
            player.position.x += 3;
            camera.lockedTarget = player;
            speed = 0;
        }
    });

    scene.onBeforeRenderObservable.add(() => {
        const dt = engine.getDeltaTime() / 16.67;

        if (keys["w"] || keys["arrowup"]) {
            if (driving) speed = Math.min(speed + 0.025 * dt, 1.2);
            else player.position.z += 0.15 * dt;
        }

        if (keys["s"] || keys["arrowdown"]) {
            if (driving) speed = Math.max(speed - 0.03 * dt, -0.6);
            else player.position.z -= 0.15 * dt;
        }

        if (keys["a"] || keys["arrowleft"]) {
            if (driving) car.rotation.y -= 0.04 * dt;
            else player.position.x -= 0.15 * dt;
        }

        if (keys["d"] || keys["arrowright"]) {
            if (driving) car.rotation.y += 0.04 * dt;
            else player.position.x += 0.15 * dt;
        }

        if (driving) {
            car.position.x += Math.sin(car.rotation.y) * speed * dt;
            car.position.z += Math.cos(car.rotation.y) * speed * dt;
            speed *= 0.99;
        } else {
            player.rotation.y = Math.atan2(
                player.position.x - car.position.x,
                player.position.z - car.position.z
            );
        }
    });

    return scene;
};

const scene = createScene();

engine.runRenderLoop(() => scene.render());

window.addEventListener("resize", () => engine.resize());
